<?xml version="1.0" encoding="UTF-8"?>
<nifty xmlns="http://nifty-gui.lessvoid.com/nifty-gui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://raw.githubusercontent.com/void256/nifty-gui/1.4/nifty-core/src/main/resources/nifty.xsd https://raw.githubusercontent.com/void256/nifty-gui/1.4/nifty-core/src/main/resources/nifty.xsd">
    <screen id="game_over_screen" controller="com.mygame.screens.GameOverScreen">
        <layer id="background" childLayout="center" backgroundImage="Interface/images/game_over.png">            
            <effect>
                <onStartScreen name="fade" />
            </effect>
            <panel id="panel_game_over" childLayout="vertical" width="90%" height="90%">
                <panel width="100%" height="90%" childLayout="center">
                    <panel width="90%" height="90%" childLayout="vertical">
                        <panel width="100%" height="50%" childLayout="center">
                            <image filename="Interface/images/logo.png"></image>
                        </panel>
                        <panel width="100%" height="50%" childLayout="vertical" padding="30px" backgroundColor="#1119">
                            <text text="La misión ha fracasado." style="base-font" color="#eeef" width="100%" />
                            <text text="Te adentraste en territorio infestado con la esperanza de recuperar suministros esenciales para el campamento." style="base-font" color="#eeef" width="100%" />
                            <text text="Medicinas, combustible y provisiones que podrían haber ayudado a los supervivientes a resistir unos días más." style="base-font" color="#eeef" width="100%" />
                            <text text="Sin embargo, la amenaza fue mayor de lo esperado." style="base-font" color="#eeef" width="100%" />
                            <text text="El campamento deberá seguir adelante sin los recursos que buscabas." style="base-font" color="#eeef" width="100%" />
                            <text text="Mientras los muertos continúan multiplicándose, cada expedición se vuelve más peligrosa que la anterior." style="base-font" color="#eeef" width="100%" />
                            <text text="Quizás otro superviviente logre completar la misión." style="base-font" color="#eeef" width="100%" />
                        </panel>
                    </panel>                    
                </panel>
                <panel width="100%" height="10%" childLayout="center">
                    <control name="button" id="startButton" visibleToMouse="true" width="300px" label="Menu principal" height="30px">
                        <effect>
                            <onFocus name="playSound" sound="menu_hover"/>
                        </effect>
                        <interact onClick="start()"/>
                    </control>
                </panel>                
            </panel>
        </layer>
    </screen>
</nifty>
