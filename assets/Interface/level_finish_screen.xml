<?xml version="1.0" encoding="UTF-8"?>
<nifty xmlns="http://nifty-gui.lessvoid.com/nifty-gui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://raw.githubusercontent.com/void256/nifty-gui/1.4/nifty-core/src/main/resources/nifty.xsd https://raw.githubusercontent.com/void256/nifty-gui/1.4/nifty-core/src/main/resources/nifty.xsd">
    <screen id="level_finish_screen" controller="com.mygame.screens.LevelFinishScreen">
        <layer id="background" childLayout="center" backgroundImage="Interface/images/fondomenu.jpg">            
            <effect>
                <onStartScreen name="fade" />
            </effect>
            <panel id="level_finish_screen" childLayout="vertical" width="90%" height="90%">
                <panel width="100%" height="50%" childLayout="center">
                    <image filename="Interface/images/logo.png"></image>
                </panel>
                <panel width="100%" height="50%" childLayout="center">
                    <panel id="GPanel1" childLayout="vertical" width="800px" height="300px" padding="20px,20px,20px,20px" style="nifty-panel">
                        <panel childLayout="vertical" width="100%" height="80%">
                            <text text="La misión se ha completado con éxito" style="base-font" color="#eeef" width="100%" />
                            <text text="Medicinas, combustible y provisiones que podrán ayudar a los supervivientes a resistir unos días más." style="base-font" color="#eeef" width="100%" />
                            <text text="Sin embargo, aún quedan misiones por completar." style="base-font" color="#eeef" width="100%" />
                        </panel>
                        <panel width="100%" height="20%" childLayout="center">
                            <control name="button" id="startButton" visibleToMouse="true" width="300px" label="Continuar" height="30px">
                                <effect>
                                    <onFocus name="playSound" sound="menu_hover"/>
                                </effect>
                                <interact onClick="start()"/>
                            </control>
                        </panel>
                    </panel>
                </panel>
            </panel>
        </layer>
    </screen>
</nifty>
